{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:5080",

  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=practicalmusic;User ID=practicalmusic;Password=CHANGE_ME;"
  },

  "Database": {
    "Provider": "MariaDb"
  },

  "Site": {
    "Name": "Practical Music",
    "BaseUrl": "",
    "DataDir": "data",
    "RequireEmailVerification": true,
    "MaxUploadMegabytes": 600,
    "PageCacheMegabytes": 2048,
    "PublicDownloads": true,
    "SupportEmail": "",
    "ApiTokenDays": 365,
    "AuthRequestsPerMinute": 20
  },

  "Email": {
    "Mode": "Pickup",
    "FromAddress": "noreply@example.com",
    "FromName": "Practical Music",
    "ReplyTo": "",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpSecurity": "StartTls",
    "SmtpUser": "",
    "SmtpPassword": "",
    "PickupDirectory": ""
  }
}

@page
@model ResetPasswordModel
@{
    ViewData["Title"] = Model.IsInvite ? "Choose your password" : "Choose a new password";
}
<div class="narrow">
    @if (!Model.LinkValid)
    {
        <h1>This link does not work</h1>
        <div class="alert warn"><p>The link has expired or was already used.</p></div>
        <p><a class="button" href="/Account/ForgotPassword">Request a new link</a></p>
    }
    else
    {
        <h1>@(Model.IsInvite ? "Welcome! Choose your password" : "Choose a new password")</h1>
        <p>Account: <b>@Model.Email</b></p>
        <form method="post" class="form">
            <div asp-validation-summary="All" class="alert error" role="alert"></div>
            <input type="hidden" asp-for="Token">
            <label>New password <span class="muted">(at least 8 characters)</span>
                <input asp-for="Password" type="password" autocomplete="new-password" required minlength="8" maxlength="200" autofocus>
            </label>
            <label>Repeat the password
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required>
            </label>
            <button type="submit" class="big">Save the password and sign in</button>
        </form>
        @if (!Model.IsInvite)
        {
            <p class="muted small">Saving signs out every other browser and every app that uses your account.</p>
        }
    }
</div>

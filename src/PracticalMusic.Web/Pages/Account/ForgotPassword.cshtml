@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<div class="narrow">
    <h1>Forgot your password?</h1>
    @if (Model.Sent)
    {
        <div class="alert ok">
            <p>If an account exists for <b>@Model.Email</b>, we sent it a link to choose a new password. The link is valid for 60 minutes.</p>
            <p>Check the spam folder if nothing arrives within a few minutes.</p>
        </div>
        <p><a class="button" href="/Account/Login">Back to sign in</a></p>
    }
    else
    {
        <p>Enter the e-mail address you sign in with. We will send you a link to choose a new password.</p>
        <form method="post" class="form">
            <label>E-mail address <input asp-for="Email" type="email" required autocomplete="email" autofocus></label>
            <button type="submit" class="big">Send the link</button>
        </form>
    }
</div>

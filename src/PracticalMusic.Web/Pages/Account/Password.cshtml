@page
@model PasswordModel
@{
    ViewData["Title"] = "Change password";
}
<h1>Your account</h1>
<nav class="tabs">
    <a href="/Account">Contact details</a>
    <a class="active" href="/Account/Password">Password</a>
    <a href="/Account/Devices">Apps &amp; devices</a>
    <a href="/Account/Organizations">My organizations</a>
</nav>
<div class="narrow left">
    <form method="post" class="form">
        <div asp-validation-summary="All" class="alert error" role="alert"></div>
        <label>Current password <input asp-for="Current" type="password" autocomplete="current-password" required></label>
        <label>New password <span class="muted">(at least 8 characters)</span>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" required minlength="8" maxlength="200">
        </label>
        <label>Repeat the new password <input asp-for="Confirm" type="password" autocomplete="new-password" required></label>
        <label class="check"><input asp-for="SignOutApps" type="checkbox"> Also sign out the apps (Windows, Linux, Android) that use my account</label>
        <button type="submit">Change the password</button>
    </form>
    <p class="muted small">Other browsers where you are signed in are signed out automatically.</p>
</div>

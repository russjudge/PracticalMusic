<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Touch friendly defaults -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Button.big">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="FontSize" Value="24" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,8,0,4" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Opacity" Value="0.65" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltMediumLowBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="Border.navbar">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <!-- guided-flow step chips in the Library (background bound in the view) -->
  <Style Selector="Border.step">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.hintbar">
    <Setter Property="Background" Value="#2A0078D7" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.section">
    <Setter Property="Background" Value="#1A808080" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>
  <Style Selector="Border.selected-song">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Background" Value="#140078D7" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>

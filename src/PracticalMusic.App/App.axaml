<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PracticalMusic.App.ViewModels"
             xmlns:views="using:PracticalMusic.App.Views"
             x:Class="PracticalMusic.App.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://PracticalMusic.App/Styles.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:LibraryViewModel">
      <views:LibraryView />
    </DataTemplate>
    <DataTemplate DataType="vm:TimingEditorViewModel">
      <views:TimingEditorView />
    </DataTemplate>
    <DataTemplate DataType="vm:PlayerViewModel">
      <views:PlayerView />
    </DataTemplate>
    <DataTemplate DataType="vm:ShareViewModel">
      <views:ShareView />
    </DataTemplate>
    <DataTemplate DataType="vm:AboutViewModel">
      <views:AboutView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>

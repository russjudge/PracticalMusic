<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PracticalMusic.App.Views"
        x:Class="PracticalMusic.App.Views.MainWindow"
        Title="{Binding Title}"
        Icon="avares://PracticalMusic.App/Assets/app-icon.ico"
        Width="1280" Height="820" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <views:MainView />
</Window>

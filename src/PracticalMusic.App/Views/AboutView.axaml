<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PracticalMusic.App.Views.AboutView">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <Image Source="avares://PracticalMusic.App/Assets/app-icon-128.png" Width="96" Height="96" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding AppName}" FontSize="32" FontWeight="Bold" />
          <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Classes="muted" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="{Binding Author, StringFormat='Author: {0}'}" FontSize="18" Margin="0,8,0,0" />
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,0" />
      <TextBlock Text="{Binding Credits}" TextWrapping="Wrap" Classes="muted" Margin="0,8,0,0" />

      <!-- the request that produced this application -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="{Binding PromptButtonText}" Command="{Binding TogglePromptCommand}" Classes="accent" />
        <Button Content="Copy prompt" Click="OnCopyPrompt" IsVisible="{Binding ShowPrompt}" />
      </StackPanel>
      <Border IsVisible="{Binding ShowPrompt}" Classes="card" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="This is the request, word for word, that Russ Judge gave Claude to create Practical Music." Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <SelectableTextBlock Text="{Binding OriginalPrompt}" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Mono, DejaVu Sans Mono, monospace" FontSize="13" />
        </StackPanel>
      </Border>

      <TextBlock Classes="h2" Text="This device" />
      <TextBlock Text="{Binding Platform, StringFormat='Platform: {0}'}" />
      <TextBlock Text="{Binding DataFolder, StringFormat='Data folder: {0}'}" TextWrapping="Wrap" Classes="muted" />
      <TextBlock Classes="h2" Text="Quick start" />
      <TextBlock TextWrapping="Wrap" Text="1. Add the PDF: in the Library press 'Add PDF…' (or drop the PDF file in). A PDF can hold many songs." />
      <TextBlock TextWrapping="Wrap" Text="2. Identify the songs: press 'Add song', give it a title and the first and last page. Repeat for every song. (Or click the first page of a song in the page overview and choose 'New song starts here'.)" />
      <TextBlock TextWrapping="Wrap" Text="3. Add recordings: select a song, then press 'Add MP3…' or drop MP3 files onto the song. A song can have several recordings (vocals, piano, …); one plays at a time." />
      <TextBlock TextWrapping="Wrap" Text="4. Edit timing: select the song and press 'Edit timing…'. Play the recording; when the music reaches the top of the next page press 'Page N starts now' (key N). Tap the page where the music is to add markers, which drive the highlight and tap-to-seek." />
      <TextBlock TextWrapping="Wrap" Text="5. Play: pages turn by themselves and the current line is highlighted; tap a spot on the page to jump there. Landscape shows two pages, portrait one. 'Full display' (or F11) makes the pages fill the whole screen; move the mouse or tap to show the controls, Esc returns." />
      <TextBlock TextWrapping="Wrap" Text="6. Save and share: 'Save (with media)' makes a self-contained .pmbook; 'Save (links only)' makes a small file that points at the PDF and MP3s. Share sends the book to other devices on your network and can keep playback in sync." />
    </StackPanel>
  </ScrollViewer>
</UserControl>

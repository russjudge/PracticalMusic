# Maintainer: Russ Judge
# PKGBUILD for Omarchy / Arch Linux. Builds from the source tree that contains this file.
#
#   cd packaging/linux/omarchy && makepkg -si
#
# Requires: dotnet-sdk (10.x) and base-devel at build time. Runtime: vlc (libvlc) for audio,
# xorg-xwayland (Avalonia renders through X11/XWayland on Hyprland).

pkgname=practical-music
pkgver=1.0.0
pkgrel=1
pkgdesc="Sheet music (PDF) linked to recordings (MP3): automatic page turns, highlighting, LAN sharing and synced playback"
arch=('x86_64' 'aarch64')
url="https://github.com/russjudge/PracticalMusic"
license=('custom')
depends=('vlc' 'fontconfig' 'libx11' 'libice' 'libsm' 'zlib' 'openssl' 'xorg-xwayland')
makedepends=('dotnet-sdk' 'git')
options=('!strip' '!debug')
install=practical-music.install
source=()
sha256sums=()

_srcroot="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$0}")")/../../.." 2>/dev/null && pwd)"

pkgver() {
  sed -n 's/.*<Version>\(.*\)<\/Version>.*/\1/p' "$_srcroot/Directory.Build.props" | head -1
}

build() {
  local rid="linux-x64"
  [ "$CARCH" = "aarch64" ] && rid="linux-arm64"
  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_NOLOGO=1
  export DOTNET_CLI_HOME="$srcdir/dotnet-home"
  export NUGET_PACKAGES="$srcdir/nuget"
  dotnet publish "$_srcroot/src/PracticalMusic.Desktop/PracticalMusic.Desktop.csproj" \
    -c Release -r "$rid" --self-contained true \
    -p:PublishSingleFile=false -p:DebugType=none \
    -o "$srcdir/publish"
}

package() {
  install -dm755 "$pkgdir/opt/practical-music/app"
  cp -r "$srcdir/publish/." "$pkgdir/opt/practical-music/app/"
  chmod 755 "$pkgdir/opt/practical-music/app/PracticalMusic"

  cat > "$pkgdir/opt/practical-music/practical-music" <<'EOF'
#!/usr/bin/env bash
exec /opt/practical-music/app/PracticalMusic "$@"
EOF
  chmod 755 "$pkgdir/opt/practical-music/practical-music"

  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/practical-music/practical-music "$pkgdir/usr/bin/practical-music"

  install -Dm644 "$_srcroot/packaging/linux/practical-music.desktop" "$pkgdir/usr/share/applications/practical-music.desktop"
  install -Dm644 "$_srcroot/packaging/app-icon-512.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/practical-music.png"
  install -Dm644 "$_srcroot/packaging/linux/omarchy/practical-music.xml" "$pkgdir/usr/share/mime/packages/practical-music.xml"
  install -Dm644 "$_srcroot/README.md" "$pkgdir/usr/share/doc/practical-music/README.md"
  install -Dm644 "$_srcroot/docs/INSTALL-Linux.md" "$pkgdir/usr/share/doc/practical-music/INSTALL-Linux.md"
}
